# Copy to .env for local `npm run dev` / verification scripts.
# On Netlify: Site configuration → Environment variables
#   - Scope must include "Functions" (or "All scopes"), not Builds only
#   - Redeploy after changing variables

# Notion careers integration
NOTION_TOKEN=
NOTION_JOBS_DATABASE_ID=
NOTION_APPLICATIONS_DATABASE_ID=

# Resend email notifications
# On Netlify, set these env vars (do not mark the public inboxes as secrets —
# they are published on the site). RESEND_API_KEY / NOTION_TOKEN stay secret.
RESEND_API_KEY=
CAREERS_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=
RESEND_FROM_EMAIL=
RESEND_CONTACT_FROM_EMAIL=
# Suggested production values:
#   CAREERS_NOTIFY_EMAIL=careers@successmetrics.io
#   CONTACT_NOTIFY_EMAIL=success@successmetrics.io
#   RESEND_FROM_EMAIL=no-reply@successmetrics.io
#   RESEND_CONTACT_FROM_EMAIL=no-reply@successmetrics.io

# Google Drive resume archive (job applications)
# Share the target folder with the service account email as Editor.
# Prefer GOOGLE_SERVICE_ACCOUNT_JSON (full JSON key) on Netlify.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or split credentials:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Analytics (optional — injected at build time)
GOOGLE_ANALYTICS_ID=

# Safe-Seed demo API proxy (server-only — never set VITE_HF_TOKEN)
# Hugging Face token with read access to the private Space adityamurthy/safe-seed-api
HF_TOKEN=
# SAFE_SEED_API_URL=
